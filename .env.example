# === Required ===
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# === OpenSky Network (Aircraft ADS-B) ===
# Get credentials at https://opensky-network.org/apidoc/rest.html
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password

# === NASA FIRMS (Active Fires) ===
# Get key at https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=your_firms_map_key

# === TomTom (Traffic Flow) ===
# Get key at https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key

# === AISStream (Ships) ===
# Get key at https://aisstream.io/
AISSTREAM_API_KEY=your_aisstream_api_key

# === Optional: Voice Control (Phase 5) ===
# OPENAI_API_KEY=your_openai_api_key
